rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBindingId(id) {
      return id is string && id.size() <= 258 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'chorcho2utkosho@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwnGuardianBindingId(bindingId) {
      return isValidBindingId(bindingId) &&
        bindingId.size() > request.auth.uid.size() + 2 &&
        bindingId[bindingId.size() - request.auth.uid.size() - 2 : bindingId.size()] == '__' + request.auth.uid;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.createdAt is timestamp &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200));
    }

    function isValidSchoolProfile(data) {
      return data.keys().hasAll(['schoolId', 'name', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['schoolId', 'name', 'address', 'phone', 'email', 'alwaysLockDevices', 'ownerUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.schoolId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('alwaysLockDevices' in data) || data.alwaysLockDevices is bool) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentRecord(data) {
      return data.keys().hasAll(['id', 'nameBn', 'roll', 'classId', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'nameBn', 'roll', 'classId', 'section', 'portalUserId',
          'guardianPhone', 'guardianNameBn', 'guardianPin', 'unlockEpoch',
          'avatarUrl', 'fatherAvatarUrl', 'motherAvatarUrl', 'photoUpdatedAt',
          'ownerUid', 'guardianUid', 'guardianUids', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 160 &&
        data.roll is number && data.roll >= 0 && data.roll <= 9999 &&
        data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 64 &&
        (!('section' in data) || (data.section is string && data.section.size() <= 32)) &&
        (!('portalUserId' in data) || (data.portalUserId is string && data.portalUserId.size() <= 64)) &&
        (!('guardianPhone' in data) || (data.guardianPhone is string && data.guardianPhone.size() <= 32)) &&
        (!('guardianNameBn' in data) || (data.guardianNameBn is string && data.guardianNameBn.size() <= 160)) &&
        (!('guardianPin' in data) || (data.guardianPin is string && data.guardianPin.size() <= 32)) &&
        (!('unlockEpoch' in data) || (data.unlockEpoch is number && data.unlockEpoch >= 0 && data.unlockEpoch <= 1000000)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 180000)) &&
        (!('fatherAvatarUrl' in data) || (data.fatherAvatarUrl is string && data.fatherAvatarUrl.size() <= 180000)) &&
        (!('motherAvatarUrl' in data) || (data.motherAvatarUrl is string && data.motherAvatarUrl.size() <= 180000)) &&
        (!('photoUpdatedAt' in data) || (data.photoUpdatedAt is string && data.photoUpdatedAt.size() <= 64)) &&
        isValidId(data.ownerUid) &&
        (!('guardianUid' in data) || (data.guardianUid is string && data.guardianUid.size() <= 128)) &&
        (!('guardianUids' in data) || (
          data.guardianUids is list &&
          data.guardianUids.size() <= 10 &&
          (data.guardianUids.size() == 0 || (data.guardianUids[0] is string && data.guardianUids[0].size() <= 128))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSecurityLog(data) {
      return data.keys().hasAll([
          'id', 'studentId', 'studentNameBn', 'studentRoll', 'classNameBn',
          'action', 'timestamp', 'status', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'studentId', 'portalUserId', 'classId', 'studentNameBn', 'studentRoll', 'classNameBn',
          'action', 'timestamp', 'serverTimestamp', 'status', 'voiceDispatched',
          'smsDispatched', 'guardianAcknowledged', 'guardianResponse',
          'acknowledgedAt', 'acknowledgedBy', 'ownerUid', 'guardianUid', 'guardianUids',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.studentId) &&
        (!('portalUserId' in data) || (data.portalUserId is string && data.portalUserId.size() <= 64)) &&
        (!('classId' in data) || (data.classId is string && data.classId.size() <= 64)) &&
        data.studentNameBn is string && data.studentNameBn.size() >= 1 && data.studentNameBn.size() <= 160 &&
        data.studentRoll is number && data.studentRoll >= 0 && data.studentRoll <= 9999 &&
        data.classNameBn is string && data.classNameBn.size() >= 1 && data.classNameBn.size() <= 80 &&
        data.action in ['entry', 'exit'] &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64 &&
        (!('serverTimestamp' in data) || data.serverTimestamp is number) &&
        data.status in ['verified', 'flagged'] &&
        (!('voiceDispatched' in data) || data.voiceDispatched is bool) &&
        (!('smsDispatched' in data) || data.smsDispatched is bool) &&
        (!('guardianAcknowledged' in data) || data.guardianAcknowledged is bool) &&
        (!('guardianResponse' in data) || (data.guardianResponse is string && data.guardianResponse.size() <= 300)) &&
        (!('acknowledgedAt' in data) || (data.acknowledgedAt is string && data.acknowledgedAt.size() <= 64)) &&
        (!('acknowledgedBy' in data) || (data.acknowledgedBy is string && data.acknowledgedBy.size() <= 160)) &&
        isValidId(data.ownerUid) &&
        (!('guardianUid' in data) || (data.guardianUid is string && data.guardianUid.size() <= 128)) &&
        (!('guardianUids' in data) || (
          data.guardianUids is list &&
          data.guardianUids.size() <= 10 &&
          (data.guardianUids.size() == 0 || (data.guardianUids[0] is string && data.guardianUids[0].size() <= 128))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGuardianSubscriber(data) {
      return data.keys().hasAll(['id', 'studentId', 'guardianUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'studentId', 'portalUserId', 'studentNameBn', 'guardianUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidBindingId(data.id) &&
        isValidId(data.studentId) &&
        (!('portalUserId' in data) || (data.portalUserId is string && data.portalUserId.size() <= 64)) &&
        (!('studentNameBn' in data) || (data.studentNameBn is string && data.studentNameBn.size() <= 160)) &&
        isValidId(data.guardianUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll([
          'id', 'staffCode', 'role', 'nameBn', 'designationBn', 'phone',
          'status', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'staffCode', 'role', 'nameBn', 'designationBn', 'categoryKey',
          'baseMonthlySalary', 'dailyShiftHours', 'overtimeHourlyRate', 'phone',
          'status', 'unlockEpoch', 'ownerUid', 'staffUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.staffCode is string && data.staffCode.size() >= 1 && data.staffCode.size() <= 40 &&
        data.role in ['official', 'employee'] &&
        data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 160 &&
        data.designationBn is string && data.designationBn.size() >= 1 && data.designationBn.size() <= 120 &&
        (!('categoryKey' in data) || (data.categoryKey is string && data.categoryKey.size() <= 40)) &&
        (!('baseMonthlySalary' in data) || (data.baseMonthlySalary is number && data.baseMonthlySalary >= 0 && data.baseMonthlySalary <= 10000000)) &&
        (!('dailyShiftHours' in data) || (data.dailyShiftHours is number && data.dailyShiftHours >= 1 && data.dailyShiftHours <= 24)) &&
        (!('overtimeHourlyRate' in data) || (data.overtimeHourlyRate is number && data.overtimeHourlyRate >= 0 && data.overtimeHourlyRate <= 100000)) &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 32 &&
        data.status in ['active', 'pending'] &&
        (!('unlockEpoch' in data) || (data.unlockEpoch is number && data.unlockEpoch >= 0 && data.unlockEpoch <= 1000000)) &&
        isValidId(data.ownerUid) &&
        (!('staffUid' in data) || (data.staffUid is string && data.staffUid.size() <= 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffLeave(data) {
      return data.keys().hasAll([
          'id', 'staffId', 'staffNameBn', 'designationBn', 'startDate', 'endDate',
          'daysCount', 'leaveType', 'reason', 'status', 'ownerUid', 'staffUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'staffId', 'staffCode', 'staffNameBn', 'designationBn', 'startDate', 'endDate',
          'daysCount', 'leaveType', 'reason', 'status', 'reviewedBy', 'reviewNote', 'ownerUid', 'staffUid',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.staffId) &&
        (!('staffCode' in data) || (data.staffCode is string && data.staffCode.size() <= 40)) &&
        data.staffNameBn is string && data.staffNameBn.size() >= 1 && data.staffNameBn.size() <= 160 &&
        data.designationBn is string && data.designationBn.size() >= 1 && data.designationBn.size() <= 120 &&
        data.startDate is string && data.startDate.size() >= 1 && data.startDate.size() <= 24 &&
        data.endDate is string && data.endDate.size() >= 1 && data.endDate.size() <= 24 &&
        data.daysCount is number && data.daysCount >= 1 && data.daysCount <= 60 &&
        data.leaveType in ['casual', 'sick', 'earned', 'emergency'] &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 160)) &&
        (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 500)) &&
        isValidId(data.ownerUid) &&
        isValidId(data.staffUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffActivity(data) {
      return data.keys().hasAll([
          'id', 'staffId', 'staffNameBn', 'designationBn', 'categoryKey', 'date',
          'title', 'timestamp', 'ownerUid', 'staffUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'staffId', 'staffNameBn', 'designationBn', 'categoryKey', 'date',
          'title', 'details', 'timestamp', 'ownerUid', 'staffUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.staffId) &&
        data.staffNameBn is string && data.staffNameBn.size() >= 1 && data.staffNameBn.size() <= 160 &&
        data.designationBn is string && data.designationBn.size() >= 1 && data.designationBn.size() <= 120 &&
        data.categoryKey is string && data.categoryKey.size() >= 1 && data.categoryKey.size() <= 40 &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 24 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        (!('details' in data) || (data.details is string && data.details.size() <= 1000)) &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64 &&
        isValidId(data.ownerUid) &&
        isValidId(data.staffUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffAttendance(data) {
      return data.keys().hasAll([
          'id', 'staffId', 'staffNameBn', 'date', 'checkInTime',
          'status', 'ownerUid', 'staffUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'staffId', 'staffCode', 'staffNameBn', 'designationBn', 'date', 'checkInTime',
          'checkInMs', 'checkOutTime', 'checkOutMs', 'workedMinutes', 'workedDurationBn',
          'action', 'status', 'note', 'serverTimestamp',
          'ownerUid', 'staffUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.staffId) &&
        (!('staffCode' in data) || (data.staffCode is string && data.staffCode.size() <= 40)) &&
        data.staffNameBn is string && data.staffNameBn.size() >= 1 && data.staffNameBn.size() <= 160 &&
        (!('designationBn' in data) || (data.designationBn is string && data.designationBn.size() <= 120)) &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 24 &&
        data.checkInTime is string && data.checkInTime.size() >= 1 && data.checkInTime.size() <= 40 &&
        (!('checkInMs' in data) || (data.checkInMs is number && data.checkInMs >= 0)) &&
        (!('checkOutTime' in data) || (data.checkOutTime is string && data.checkOutTime.size() <= 40)) &&
        (!('checkOutMs' in data) || (data.checkOutMs is number && data.checkOutMs >= 0)) &&
        (!('workedMinutes' in data) || (data.workedMinutes is number && data.workedMinutes >= 0 && data.workedMinutes <= 10080)) &&
        (!('workedDurationBn' in data) || (data.workedDurationBn is string && data.workedDurationBn.size() <= 80)) &&
        (!('action' in data) || data.action in ['checkin', 'checkout']) &&
        data.status in ['present', 'late', 'leave'] &&
        (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
        (!('serverTimestamp' in data) || data.serverTimestamp is number) &&
        isValidId(data.ownerUid) &&
        isValidId(data.staffUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDailyAttendance(data) {
      return data.keys().hasAll([
          'id', 'date', 'classId', 'presentCount', 'absentCount', 'lateCount',
          'leaveCount', 'totalStudents', 'recordsJson', 'ownerUid', 'updatedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'date', 'academicYear', 'classId', 'section',
          'presentCount', 'absentCount', 'lateCount', 'leaveCount', 'totalStudents',
          'recordsJson', 'ownerUid', 'updatedByUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 24 &&
        (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 24)) &&
        data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 64 &&
        (!('section' in data) || (data.section is string && data.section.size() <= 32)) &&
        data.presentCount is number && data.presentCount >= 0 && data.presentCount <= 10000 &&
        data.absentCount is number && data.absentCount >= 0 && data.absentCount <= 10000 &&
        data.lateCount is number && data.lateCount >= 0 && data.lateCount <= 10000 &&
        data.leaveCount is number && data.leaveCount >= 0 && data.leaveCount <= 10000 &&
        data.totalStudents is number && data.totalStudents >= 0 && data.totalStudents <= 10000 &&
        data.recordsJson is string && data.recordsJson.size() >= 2 && data.recordsJson.size() <= 120000 &&
        isValidId(data.ownerUid) &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLibraryMaterial(data) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'fileType', 'classId', 'fileName',
          'mimeType', 'fileSizeBytes', 'fileUrl', 'uploadedBy',
          'downloadsCount', 'academicYear', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'category', 'fileType', 'classId',
          'subjectId', 'subjectNameBn', 'chapter', 'fileName', 'mimeType',
          'fileSizeBytes', 'fileUrl', 'isExternalUrl', 'uploadedBy',
          'uploadedByRole', 'downloadsCount', 'academicYear', 'ownerUid',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500)) &&
        data.category in ['ebook', 'pdf_lecture', 'notes', 'question_bank', 'guide'] &&
        data.fileType in ['pdf', 'ebook', 'document', 'presentation', 'image', 'link'] &&
        data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 64 &&
        (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 64)) &&
        (!('subjectNameBn' in data) || (data.subjectNameBn is string && data.subjectNameBn.size() <= 120)) &&
        (!('chapter' in data) || (data.chapter is string && data.chapter.size() <= 160)) &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 240 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 128 &&
        data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 104857600 &&
        data.fileUrl is string && data.fileUrl.size() >= 1 && data.fileUrl.size() <= 1000 &&
        (!('isExternalUrl' in data) || data.isExternalUrl is bool) &&
        data.uploadedBy is string && data.uploadedBy.size() >= 1 && data.uploadedBy.size() <= 160 &&
        (!('uploadedByRole' in data) || data.uploadedByRole in ['official', 'employee']) &&
        data.downloadsCount is number && data.downloadsCount >= 0 && data.downloadsCount <= 10000000 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 24 &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminUser(incoming());
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list, create, update, delete: if false;
    }

    match /schools/{schoolId} {
      allow get: if isSignedIn() && isValidId(schoolId) && (isAdmin() || resource == null || existing().ownerUid == request.auth.uid);
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(schoolId) && isValidSchoolProfile(incoming()) &&
        incoming().schoolId == schoolId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(schoolId) && isValidSchoolProfile(incoming()) &&
        incoming().schoolId == existing().schoolId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() || (
          existing().ownerUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phone', 'email', 'alwaysLockDevices', 'updatedAt'])
        ));
      allow delete: if isAdmin() && isValidId(schoolId);

      match /students/{studentId} {
        allow get: if isSignedIn() && isValidId(schoolId) && isValidId(studentId) &&
          (isAdmin() ||
            (resource == null && exists(/databases/$(database)/documents/schools/$(schoolId)) &&
              get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid) ||
            (resource != null && (existing().ownerUid == request.auth.uid || existing().guardianUid == request.auth.uid ||
              ('guardianUids' in existing() && existing().guardianUids is list && request.auth.uid in existing().guardianUids))));
        allow list: if isBootstrappedAdmin() ||
          (isSignedIn() && (
            resource.data.ownerUid == request.auth.uid ||
            resource.data.guardianUid == request.auth.uid ||
            request.auth.uid in resource.data.guardianUids
          ));
        allow create: if isSignedIn() && isValidId(schoolId) && isValidId(studentId) &&
          isValidStudentRecord(incoming()) &&
          incoming().id == studentId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/schools/$(schoolId)) &&
          (isAdmin() || get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid);
        allow update: if isSignedIn() && isValidId(schoolId) && isValidId(studentId) &&
          isValidStudentRecord(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isAdmin() || (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nameBn', 'roll', 'classId', 'section', 'portalUserId',
              'guardianPhone', 'guardianNameBn', 'guardianPin', 'unlockEpoch',
              'avatarUrl', 'fatherAvatarUrl', 'motherAvatarUrl', 'photoUpdatedAt',
              'guardianUid', 'guardianUids', 'updatedAt'
            ])
          ));
        allow delete: if isSignedIn() && isValidId(schoolId) && isValidId(studentId) &&
          (isAdmin() || existing().ownerUid == request.auth.uid);
      }

      match /guardianSubscribers/{bindingId} {
        allow get: if isSignedIn() && isValidId(schoolId) && isValidBindingId(bindingId) &&
          (isAdmin() ||
            (resource == null && isOwnGuardianBindingId(bindingId)) ||
            (resource != null && (existing().guardianUid == request.auth.uid ||
              (exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid))));
        allow list: if isBootstrappedAdmin() ||
          (isSignedIn() && resource.data.guardianUid == request.auth.uid);
        allow create: if isSignedIn() && isValidId(schoolId) && isValidBindingId(bindingId) &&
          isValidGuardianSubscriber(incoming()) &&
          incoming().id == bindingId &&
          incoming().guardianUid == request.auth.uid &&
          incoming().id == incoming().studentId + '__' + request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isSignedIn() && isValidId(schoolId) && isValidBindingId(bindingId) &&
          isValidGuardianSubscriber(incoming()) &&
          incoming().id == existing().id &&
          incoming().studentId == existing().studentId &&
          incoming().guardianUid == existing().guardianUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isAdmin() || (
            existing().guardianUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'portalUserId', 'studentNameBn', 'updatedAt'
            ])
          ));
        allow delete: if isSignedIn() && isValidId(schoolId) && isValidBindingId(bindingId) &&
          (isAdmin() || existing().guardianUid == request.auth.uid);
      }

      match /securityLogs/{logId} {
        allow get: if isSignedIn() && isValidId(schoolId) && isValidId(logId) &&
          (isAdmin() ||
            (resource == null && exists(/databases/$(database)/documents/schools/$(schoolId)) &&
              get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid) ||
            (resource != null && (existing().ownerUid == request.auth.uid || existing().guardianUid == request.auth.uid ||
