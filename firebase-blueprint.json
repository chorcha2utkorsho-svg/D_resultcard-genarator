          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "staffCode": {
          "type": "string",
          "maxLength": 40
        },
        "staffNameBn": {
          "type": "string",
          "maxLength": 160
