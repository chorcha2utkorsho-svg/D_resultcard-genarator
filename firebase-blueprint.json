    "GuardianSubscriber": {
      "title": "GuardianSubscriber",
      "description": "Verified guardian device binding to a specific student for automatic live gatepass push delivery.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 258,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "portalUserId": {
          "type": "string",
          "maxLength": 64
        },
        "studentNameBn": {
          "type": "string",
          "maxLength": 160
        },
        "guardianUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "studentId", "guardianUid", "createdAt", "updatedAt"]
