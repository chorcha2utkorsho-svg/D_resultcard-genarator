          "type": "string",
          "maxLength": 1000
        },
        "isExternalUrl": {
          "type": "boolean"
        },
        "uploadedBy": {
          "type": "string",
          "maxLength": 160
        },
        "uploadedByRole": {
          "type": "string",
          "enum": ["official", "employee"],
          "maxLength": 16
        },
        "downloadsCount": {
          "type": "number"
        },
        "academicYear": {
          "type": "string",
          "maxLength": 24
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
