    "LibraryMaterial": {
      "title": "LibraryMaterial",
      "description": "Digital library resource metadata uploaded by teachers or school officials.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
