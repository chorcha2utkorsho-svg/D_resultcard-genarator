          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending"],
          "maxLength": 16
        },
        "unlockEpoch": {
          "type": "number"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "staffUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "staffCode", "role", "nameBn", "designationBn", "phone", "status", "ownerUid", "createdAt", "updatedAt"]
    },
    "StaffLeaveRequest": {
      "title": "StaffLeaveRequest",
