{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized school administrator UID registration.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    },
    "SchoolProfile": {
      "title": "SchoolProfile",
      "description": "Core school metadata and ownership record.",
      "type": "object",
      "properties": {
        "schoolId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "phone": {
          "type": "string",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "alwaysLockDevices": {
          "type": "boolean"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["schoolId", "name", "ownerUid", "createdAt", "updatedAt"]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Synchronized student profile and portal access metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nameBn": {
          "type": "string",
          "maxLength": 160
        },
        "roll": {
          "type": "number"
        },
        "classId": {
          "type": "string",
          "maxLength": 64
        },
        "section": {
          "type": "string",
          "maxLength": 32
        },
        "portalUserId": {
          "type": "string",
          "maxLength": 64
        },
        "guardianPhone": {
          "type": "string",
          "maxLength": 32
        },
        "guardianNameBn": {
          "type": "string",
          "maxLength": 160
        },
        "guardianPin": {
          "type": "string",
          "maxLength": 32
        },
        "unlockEpoch": {
          "type": "number"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 180000
        },
        "fatherAvatarUrl": {
          "type": "string",
          "maxLength": 180000
        },
        "motherAvatarUrl": {
          "type": "string",
          "maxLength": 180000
        },
        "photoUpdatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "guardianUid": {
          "type": "string",
          "maxLength": 128
        },
        "guardianUids": {
          "type": "array",
          "description": "Bounded list (max 10) of verified guardian UIDs bound to this student."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "nameBn", "roll", "classId", "ownerUid", "createdAt", "updatedAt"]
    },
    "SecurityGatepassLog": {
      "title": "SecurityGatepassLog",
      "description": "Live school gate entry/exit scan log and guardian voice response state.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "portalUserId": {
          "type": "string",
          "maxLength": 64
        },
        "classId": {
          "type": "string",
          "maxLength": 64
        },
        "studentNameBn": {
          "type": "string",
          "maxLength": 160
        },
        "studentRoll": {
          "type": "number"
        },
        "classNameBn": {
          "type": "string",
          "maxLength": 80
        },
        "action": {
          "type": "string",
          "enum": ["entry", "exit"],
          "maxLength": 16
        },
        "timestamp": {
          "type": "string",
          "maxLength": 64
        },
        "serverTimestamp": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["verified", "flagged"],
          "maxLength": 16
        },
        "voiceDispatched": {
          "type": "boolean"
        },
        "smsDispatched": {
          "type": "boolean"
        },
        "guardianAcknowledged": {
          "type": "boolean"
        },
        "guardianResponse": {
          "type": "string",
          "maxLength": 300
        },
        "acknowledgedAt": {
          "type": "string",
          "maxLength": 64
        },
        "acknowledgedBy": {
          "type": "string",
          "maxLength": 160
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "guardianUid": {
          "type": "string",
          "maxLength": 128
        },
        "guardianUids": {
          "type": "array",
          "description": "Bounded list (max 10) of verified guardian UIDs subscribed for live alerts."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "studentId", "studentNameBn", "studentRoll", "classNameBn", "action", "timestamp", "status", "ownerUid", "createdAt", "updatedAt"]
    },
    "StaffAccount": {
